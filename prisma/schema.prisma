generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  nombre    String
  usuario   String    @unique // Login username
  rol       String    // mozo, cocina, caja, admin
  password  String
  foto      String?   // URL to profile photo
  comandas  Comanda[]
  detallesCocina DetalleComanda[] @relation("Cocinero")
  movimientosInsumo MovimientoInsumo[]
}

model Mesa {
  id          Int       @id @default(autoincrement())
  numero      String    @unique
  capacidad   Int
  estado      String    @default("libre") // libre, ocupada, cerrada
  posX        Float     @default(0)
  posY        Float     @default(0)
  forma       String    @default("cuadrada")
  comandas    Comanda[]

  // Relación Padre-Hijo para unión de mesas
  mesaPadreId Int?
  mesaPadre   Mesa?     @relation("MesaUnion", fields: [mesaPadreId], references: [id])
  mesasHijas  Mesa[]    @relation("MesaUnion")

  @@index([estado])
}



model Categoria {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique
  icono   String?
  color   String   @default("#000000")
  orden   Int      @default(0)
  activo  Boolean  @default(true)
  deleted Boolean  @default(false) // Soft Delete
  enviarCocina Boolean @default(true)
  platos  Plato[]
}

model Plato {
  id              Int              @id @default(autoincrement())
  nombre          String
  descripcion     String?
  precio          Float
  categoriaId     Int
  categoria       Categoria        @relation(fields: [categoriaId], references: [id])
  imagen          String?
  activo          Boolean          @default(true)
  deleted         Boolean          @default(false)
  fechaCreacion   DateTime         @default(now())
  ultimaModificacion DateTime      @updatedAt
  costoProduccion Float            @default(0)
  margenGanancia  Float            @default(0)
  receta          RecetaInsumo[]
  detalles        DetalleComanda[]
}

model Comanda {
  id        Int              @id @default(autoincrement())
  mesaId    Int
  mesa      Mesa             @relation(fields: [mesaId], references: [id])
  usuarioId Int
  usuario   User             @relation(fields: [usuarioId], references: [id])
  fecha     DateTime         @default(now())
  estado    String           @default("pendiente") // pendiente, enviada, preparando, lista, entregada, cerrada
  comensales Int             @default(1)
  
  // Payment Fields
  metodoPago    String?   // efectivo, tarjeta, yape
  tipoDocumento String?   // boleta, factura, sin_comprobante
  montoRecibido Float?
  propina       Float     @default(0)
  observacion   String?
  emailCliente  String?
  
  tipoComprobante String? @default("ticket") @map("tipo_comprobante")
  documentoCliente String? @map("documento_cliente")
  razonSocial     String? @map("razon_social")
  direccionFiscal String? @map("direccion_fiscal")
  
  detalles  DetalleComanda[]

  @@index([mesaId, estado])
}

model Arqueo {
  id           Int       @id @default(autoincrement())
  fechaInicio  DateTime  @default(now())
  fechaFin     DateTime?
  montoInicial Float
  montoFinal   Float?
  estado       String    @default("abierto") // abierto, cerrado
  usuarioId    Int
  movimientos  MovimientoCaja[]
}

model MovimientoCaja {
  id              Int      @id @default(autoincrement())
  arqueoId        Int
  arqueo          Arqueo   @relation(fields: [arqueoId], references: [id], onDelete: Cascade)
  tipo            String   // INGRESO, EGRESO
  tipoComprobante String   // boleta, factura, recibo
  concepto        String
  observacion     String?
  monto           Float
  fecha           DateTime @default(now())
  metodoPago      String   @default("efectivo")
}

model DetalleComanda {
  id        Int     @id @default(autoincrement())
  comandaId Int
  comanda   Comanda @relation(fields: [comandaId], references: [id])
  platoId   Int
  plato     Plato   @relation(fields: [platoId], references: [id])
  cantidad  Int
  estado    String  @default("pendiente") // pendiente, preparando, listo
  observacion String?
  cocineroId Int?
  cocinero   User?   @relation("Cocinero", fields: [cocineroId], references: [id])
  fechaCreacion    DateTime @default(now())
  fechaPreparacion DateTime?
  fechaListo       DateTime?

  @@index([comandaId])
}

model Insumo {
  id              Int              @id @default(autoincrement())
  nombre          String           @unique
  precioCompra    Float            // Precio unitario bruto
  unidadMedida    String           // ej. kg, gr, L, ud
  stock           Float            @default(0)
  stockMinimo     Float            @default(0)
  notificarAlerta Boolean          @default(false)
  activo          Boolean          @default(true)
  deleted         Boolean          @default(false)
  recetas         RecetaInsumo[]
  movimientos     MovimientoInsumo[]
}

model RecetaInsumo {
  id        Int    @id @default(autoincrement())
  platoId   Int
  plato     Plato  @relation(fields: [platoId], references: [id], onDelete: Cascade)
  insumoId  Int
  insumo    Insumo @relation(fields: [insumoId], references: [id])
  cantidad  Float  // Cantidad consumida de la unidadMedida del Insumo

  @@unique([platoId, insumoId])
}

model MovimientoInsumo {
  id              Int      @id @default(autoincrement())
  insumoId        Int
  tipoMovimiento  String   // 'COMPRA', 'VENTA', 'TRANSFERENCIA', 'MERMA', 'AJUSTE'
  cantidad        Float
  motivo          String?
  usuarioId       Int
  fecha           DateTime @default(now())
  
  insumo          Insumo   @relation(fields: [insumoId], references: [id])
  usuario         User     @relation(fields: [usuarioId], references: [id])
}

model PedidoCancelado {
  id                 Int      @id @default(autoincrement())
  comandaId          Int
  mesa               String
  usuarioResponsable String
  motivo             String?
  totalAnulado       Float
  fecha              DateTime @default(now())
}

model PermisoModulo {
  id          Int      @id @default(autoincrement())
  rol         String   // 'mozo', 'cocina', 'caja', 'admin'
  modulo      String   // 'mesas', 'cocina', 'caja', 'logistica', 'reportes', 'usuarios'
  habilitado  Boolean  @default(true)
  
  @@unique([rol, modulo])
  @@map("permisos_modulos")
}

model Configuracion {
  clave String @id
  valor String
}

model TicketPendiente {
  id        Int      @id @default(autoincrement())
  mesa_id   String
  mozo      String
  contenido Json
  impreso   Boolean  @default(false)
  estacion  String   @default("Caja")
  creado_a  DateTime @default(now())

  @@map("tickets_pendientes")
}

